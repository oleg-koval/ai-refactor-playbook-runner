{
  "name": "ai-refactor-playbook-runner",
  "version": "1.1.0",
  "description": "Markdown-driven AI refactor playbook runner with CLI and local web UI",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": {
    "name": "Oleg Koval",
    "email": "oleg@bizcuit.nl",
    "url": "https://olegkoval.com"
  },
  "homepage": "https://oleg-koval.github.io/ai-refactor-playbook-runner/",
  "repository": {
    "type": "git",
    "url": "https://github.com/oleg-koval/ai-refactor-playbook-runner.git"
  },
  "bugs": {
    "url": "https://github.com/oleg-koval/ai-refactor-playbook-runner/issues"
  },
  "keywords": [
    "playbook",
    "refactor",
    "typescript",
    "cli",
    "markdown"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "ai-refactor-playbook-runner": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "examples"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsup",
    "build:docs": "typedoc --out docs/api src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run typecheck && npm run lint && npm run test:coverage",
    "semantic-release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "docs:index": "docs-index-keeper update",
    "prepare": "lefthook install"
  }
}
